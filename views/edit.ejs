<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit chat</title>
    <link rel="stylesheet" href="/new.css" />
  </head>
  <body>
    <div class="container">
      <h3>Edit your chat</h3>
      <p class="subtitle">
        This chat was sent from <%= chat.from %> to <%= chat.to %>
      </p>

      <form method="POST" action="/chats/<%= chat._id %>?_method=PUT">
        <textarea name="msg" required style="height: 100px"><%= chat.msg %></textarea>
        <button type="submit">Edit Chat →</button>
      </form>
    </div>
  </body>
</html>
