<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Chat</title>
    <link rel="stylesheet" href="/new.css" />
  </head>

  <body>
    <div class="container">
      <h3>Write New Chat</h3>
      <p class="subtitle">Start a new conversation with someone!</p>

      <form method="post" action="/chats">
        <input placeholder="Who are you?" name="from" required />

        <textarea
          placeholder="Write your message here..."
          name="msg"
          required
        ></textarea>

        <input placeholder="Receiver name..." name="to" required />

        <button type="submit">Create Chat →</button>
      </form>
    </div>
  </body>
</html>
